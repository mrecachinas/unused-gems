{
  "name": "unused-gems",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "CARGO_TERM_COLOR": "always"
  },
  // Keep build artifacts off the bind mount (much faster on macOS/Windows).
  "mounts": [
    "source=unused-gems-target-${devcontainerId},target=${containerWorkspaceFolder}/target,type=volume"
  ],
  "onCreateCommand": "sudo chown vscode:vscode target && rustup toolchain install 1.88.0 --profile minimal",
  "postCreateCommand": "cargo build --locked",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  }
}
